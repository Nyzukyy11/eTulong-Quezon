<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ETulongDesktop.App" RequestedThemeVariant="Light">
 <Application.Styles><FluentTheme/><Style Selector="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="CornerRadius" Value="6"/></Style><Style Selector="TextBox"><Setter Property="MinHeight" Value="34"/></Style><Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#42526A"/></Style><Style Selector="Button.primary"><Setter Property="Background" Value="#176B68"/><Setter Property="Foreground" Value="White"/></Style></Application.Styles>
</Application>
